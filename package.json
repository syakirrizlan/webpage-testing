{
  "name": "redzai-guesthouse",
  "private": true,
  "description": "Booking website for Redzai Guesthouse (static site + Firebase).",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:rules": "firebase emulators:exec --project demo-homestay --only firestore \"node --test tests/rules/firestore.test.mjs\"",
    "test:all": "npm test && npm run test:rules",
    "serve": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.36.0"
  }
}
