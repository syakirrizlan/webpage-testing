rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isDate(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Member profiles: private to their owner.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'phone', 'joined'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30;
    }

    // Bookings: a member can see, create and cancel only their own.
    match /bookings/{bookingId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['roomId', 'userId', 'checkIn', 'checkOut', 'guests', 'status'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'confirmed'
        && request.resource.data.roomId in ['house', 'r1', 'r2', 'r3']
        && isDate(request.resource.data.checkIn)
        && isDate(request.resource.data.checkOut)
        && request.resource.data.checkIn < request.resource.data.checkOut
        && request.resource.data.guests is int
        && request.resource.data.guests >= 1
        && request.resource.data.guests <= 20;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'cancelled';
    }

    // One document per booked night of a room, id "<roomId>_<date>". Anyone
    // can read them to see availability (they hold no personal data). Creating
    // one that already exists counts as an update, which is not allowed, so
    // two members can never book the same night. A whole-house booking creates
    // a night for each of r1, r2 and r3, so it can't overlap a room booking.
    match /nights/{nightId} {
      function booking(id) {
        return getAfter(/databases/$(database)/documents/bookings/$(id)).data;
      }

      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['roomId', 'date', 'bookingId'])
        && request.resource.data.roomId in ['r1', 'r2', 'r3']
        && nightId == request.resource.data.roomId + '_' + request.resource.data.date
        && booking(request.resource.data.bookingId).userId == request.auth.uid
        && booking(request.resource.data.bookingId).roomId in [request.resource.data.roomId, 'house']
        && booking(request.resource.data.bookingId).status == 'confirmed'
        && request.resource.data.date >= booking(request.resource.data.bookingId).checkIn
        && request.resource.data.date < booking(request.resource.data.bookingId).checkOut;
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.userId == request.auth.uid;
    }
  }
}
